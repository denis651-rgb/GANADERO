# Catálogo de variables. Copiar solo las necesarias a archivos .env ignorados.
# App de escritorio de un solo usuario local: no hay secretos de nube que gestionar aquí.
# Ver backend/.env.example para el detalle completo del backend.

# Backend (ver backend/.env.example)
SPRING_PROFILES_ACTIVE=local
GANADERO_DB_PATH=./data/ganadero.db
GANADERO_MEDIA_PATH=./data/media
APP_FRONTEND_URL=http://localhost:5173

# Frontend (opcional; por defecto apunta a http://localhost:8080)
VITE_API_URL=http://localhost:8080

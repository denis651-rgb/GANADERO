# Catálogo de variables. Copiar solo las necesarias a archivos .env ignorados.
# Las contraseñas, tokens y claves son privadas; nunca deben confirmarse en Git.

# Backend
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:55432/ganadero
DATABASE_USERNAME=ganadero
DATABASE_PASSWORD=change_me
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Alias admitido: SUPABASE_JWKS_URL
SUPABASE_SERVICE_ROLE_KEY=change_me
SUPABASE_STORAGE_BUCKET=ganadero-private
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/La_Paz
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_TOKEN=change_me
APP_SYSTEM_STATUS_ENABLED=false
INTERNAL_JOB_TOKEN=change_me
JAVA_TOOL_OPTIONS=-Xms96m -Xmx320m -XX:MaxMetaspaceSize=128m

# Frontend (SUPABASE_SERVICE_ROLE_KEY nunca debe exponerse aquí)
VITE_API_URL=http://localhost:8080
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_change_me
# Compatibilidad con proyectos Supabase antiguos:
VITE_SUPABASE_ANON_KEY=change_me
VITE_ENFORCE_UI_PERMISSIONS=false
VITE_APP_ENV=local
